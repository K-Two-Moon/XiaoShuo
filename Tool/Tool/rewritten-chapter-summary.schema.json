{
  "type": "object",
  "additionalProperties": false,
  "required": ["起始章节数", "结束章节数", "章节摘要"],
  "properties": {
    "起始章节数": {
      "type": "integer"
    },
    "结束章节数": {
      "type": "integer"
    },
    "章节摘要": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "章节数",
          "情节概括",
          "叙述主线",
          "情感主线",
          "人物心情变化",
          "人物性格改变",
          "当前时间线",
          "增量信息"
        ],
        "properties": {
          "章节数": {
            "type": "integer"
          },
          "情节概括": {
            "type": "string",
            "maxLength": 220,
            "description": "用 1-3 句简体中文概括本章起因、发展、转折与结果。"
          },
          "叙述主线": {
            "type": "string",
            "maxLength": 100,
            "description": "本章推进的核心事件或目标。"
          },
          "情感主线": {
            "type": "string",
            "maxLength": 120,
            "description": "人物关系或情感变化；没有则写无。"
          },
          "人物心情变化": {
            "type": "string",
            "maxLength": 100,
            "description": "重要人物的情绪变化；没有则写无。"
          },
          "人物性格改变": {
            "type": "string",
            "maxLength": 100,
            "description": "重要人物的性格或行为倾向变化；没有则写无。"
          },
          "当前时间线": {
            "type": "string",
            "maxLength": 100,
            "description": "本章相对前文的时间点或时间推进；不明确则写无。"
          },
          "增量信息": {
            "type": "string",
            "maxLength": 160,
            "description": "本章新增或推进的设定、线索、伏笔、目标、能力、关系或风险；没有则写无。"
          }
        }
      }
    }
  }
}
