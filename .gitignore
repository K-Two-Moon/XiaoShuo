# 默认不同步任何文件。
*

# 保留同步规则本身。
!/.gitignore

# Codex project skills.
!/.codex/
!/.codex/skills/
!/.codex/skills/**

# 同步文件夹下的所有内容。
!/原文/
!/原文/**

!/章节拆分/
!/章节拆分/**

!/摘要/
!/摘要/**

!/大纲/
!/大纲/**

!/大纲改写/
!/大纲改写/**

!/正文/
!/正文/**

!/新改写摘要/
!/新改写摘要/**

!/Tool/Tool/
!/Tool/Tool/**

# 只同步 Tool 下的 C# 源码文件。
!/Tool/
!/Tool/**/
!/Tool/**/*.cs
!/Tool/Tool/novel-outline.schema.json

# 不同步构建产物中的生成源码。
/Tool/**/bin/
/Tool/**/bin/**
/Tool/**/obj/
/Tool/**/obj/**
